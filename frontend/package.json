{
  "name": "tale-tinker-app",
  "description": "Tailwind build pipeline for the Django-rendered TaleTinker frontend",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -c ./tailwind.config.cjs -i ./styles/app.css -o ../static/css/app.css --watch",
    "build": "tailwindcss -c ./tailwind.config.cjs -i ./styles/app.css -o ../static/css/app.css --minify"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15"
  }
}
